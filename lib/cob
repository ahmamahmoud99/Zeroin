void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform);
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    // اللون البنفسجي الجميل اللي اخترتيه للهوية البصرية
    const Color primaryPurple = Color(0xFF787BB3);
    const Color backgroundLight = Color(0xFFF3F0FF);

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Zorin App',
      theme: ThemeData(
        useMaterial3: true,
        // تأكدي من إضافة الخط في pubspec.yaml أو سيستخدم الخط الافتراضي
        fontFamily: 'Cairo',
        scaffoldBackgroundColor: backgroundLight,
        colorScheme: ColorScheme.fromSeed(
          seedColor: primaryPurple,
          primary: primaryPurple,
          secondary: const Color(0xFF9FA2D5),
        ),
        // تخصيص شكل الأزرار لتكون مودرن
        elevatedButtonTheme: ElevatedButtonThemeData(
          style: ElevatedButton.styleFrom(
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(12),
            ),
            padding: const EdgeInsets.symmetric(vertical: 15, horizontal: 25),
          ),
        ),
      ),

      // البداية من الـ Intro عشان الدكتور يشوف الانطباع الأول
      initialRoute: '/intro',

      routes: {
        // رحلة المستخدم
        '/intro': (context) => const MyIntroScreens(),
        '/welcome': (context) => const WelcomeScreen(),
        '/login': (context) => const LoginScreen(),

        // المحطة الذكية (الـ AI Orientation) - تظهر بعد اللوجن مباشرة
        '/ai_orientation': (context) => AIOrientationScreen(),

        // المحتوى التعليمي
        '/tracks': (context) => const TracksScreen(userName: "rahma12"),
        '/levels': (context) => const LevelsScreen(),
        '/lessons': (context) => const LessonsScreen(),
        '/video_player': (context) => const VideoPlayerScreen(),

        // المجتمع والتقييم
        '/quiz': (context) => const QuizMainScreen(),
        '/community': (context) => const CommunityFeedScreen(),
      },
    );
  }
}

